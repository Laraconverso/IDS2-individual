# Configuración del Servidor
# HOST: Dirección IP donde escucha el servicio (0.0.0.0 = cualquier red)
# PORT: Puerto HTTP del servicio
# ENVIRONMENT: Entorno (development o production)


# Configuración de Base de Datos
# DATABASE_HOST: Host del servidor PostgreSQL
# DATABASE_PORT: Puerto de PostgreSQL (default: 5432)
# DATABASE_NAME: Nombre de la base de datos
# DATABASE_USER: Usuario para conectar a PostgreSQL
# DATABASE_PASSWORD: Contraseña de PostgreSQL

